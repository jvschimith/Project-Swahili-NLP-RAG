[flake8]
# ============================================
# FLAKE8 CONFIGURATION
# ============================================

# Maximum line length
max-line-length = 100

# Exclude directories
exclude =
    .git,
    __pycache__,
    venv,
    env,
    .venv,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    htmlcov

# Ignore specific errors
ignore =
    # E203: whitespace before ':' (conflicts with black)
    E203,
    # W503: line break before binary operator (conflicts with black)
    W503,
    # E501: line too long (handled by black)
    E501,

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    tests/*:F401,F811

# Maximum complexity
max-complexity = 10

# Show source code for errors
show-source = True

# Count errors
count = True

# Statistics
statistics = True
