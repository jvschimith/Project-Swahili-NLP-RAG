# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
data/logs/*
!data/logs/.gitkeep
data/backups/
data/reports/

# Generated or downloaded research artifacts
data/embeddings/*
!data/embeddings/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/corpus/**
!data/corpus/README.md
data/live-crawl-demo/
data/raw/**
!data/raw/README.md
!data/raw/**/
!data/raw/**/.gitkeep
reports/*
!reports/.gitkeep

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*~

# Copyrighted/private linguistic references (development harness only)
references/private/
references/*.pdf
