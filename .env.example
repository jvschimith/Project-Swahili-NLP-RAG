# ============================================
# SWAHILI NLP RAG - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to `.env` and adjust the values

# -------------------- MINIMUM LOCAL SETUP --------------------
# The values in this file are enough for a local SQLite-based run.
# For Release 1 local execution, the most important settings are:
# - DATABASE_URL
# - LOG_LEVEL
# - ENVIRONMENT
# - DEBUG
# - API_URL (used by Streamlit)

# -------------------- DATABASE --------------------
# Database connection URL
# For SQLite (development):
DATABASE_URL=sqlite:///data/swahili_knowledge.db
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/swahili_nlp

# -------------------- LOGGING --------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file (leave empty for console only)
LOG_FILE=data/logs/app.log

# -------------------- PROCESSING --------------------
# Batch size for processing
BATCH_SIZE=1000

# Minimum word length to process
MIN_WORD_LENGTH=2

# Maximum word length
MAX_WORD_LENGTH=50

# -------------------- PATHS --------------------
# Data directories (relative to the project root)
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
EMBEDDINGS_DIR=data/embeddings
LOGS_DIR=data/logs

# -------------------- MASAKHANE FILES --------------------
MASAKHANE_POS_FILE=data/raw/masakhane-pos/pos_swa_test.txt
MASAKHANE_NER_FILE=data/raw/masakhane-ner/ner_swa_test.txt
MASAKHANE_NEWS_FILE=data/raw/masakhane-news/news_swa_test.tsv

# -------------------- KAMUSI FILES --------------------
KAMUSI_CSV_FILE=data/raw/kamusi/words.csv
KAMUSI_JSON_FILE=data/raw/kamusi/words.json

# -------------------- DATABASE VERSION --------------------
# Database schema version
SCHEMA_VERSION=0.2.0

# -------------------- APPLICATION --------------------
# Application name
APP_NAME=Swahili NLP RAG

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (do not use in production!)
DEBUG=True

# Streamlit uses this to reach the local FastAPI server.
API_URL=http://localhost:8000

# -------------------- API CONFIGURATION --------------------
# The API is currently started via uvicorn CLI or Makefile commands.
# These values are documented for local consistency.
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -------------------- EXTERNAL SERVICES (optional) --------------------
# OpenAI API key (for embeddings/RAG)
# OPENAI_API_KEY=sk-...

# Anthropic API key (for Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# -------------------- CACHING --------------------
# Embedding cache
CACHE_EMBEDDINGS=True

# Cache TTL (in seconds)
CACHE_TTL=3600

# -------------------- PERFORMANCE --------------------
# Number of workers for parallel processing
NUM_WORKERS=4

# Timeout for long-running queries (in seconds)
QUERY_TIMEOUT=30

# -------------------- SECURITY --------------------
# Secret key for sessions (generate a random value in production)
SECRET_KEY=your-secret-key-here-change-in-production

# JWT expiration (in hours)
JWT_EXPIRATION=24

# -------------------- MONITORING (optional) --------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://...

# Analytics
# ANALYTICS_ENABLED=False
