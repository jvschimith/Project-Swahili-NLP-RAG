# ============================================
# SWAHILI NLP RAG - ENVIRONMENT VARIABLES
# ============================================
# Copie este arquivo para .env e ajuste os valores

# -------------------- DATABASE --------------------
# URL de conexão do banco de dados
# Para SQLite (desenvolvimento):
DATABASE_URL=sqlite:///data/swahili_knowledge.db

# Para PostgreSQL (produção):
# DATABASE_URL=postgresql://user:password@localhost:5432/swahili_nlp

# -------------------- LOGGING --------------------
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Arquivo de log (deixe vazio para apenas console)
LOG_FILE=data/logs/app.log

# -------------------- PROCESSING --------------------
# Tamanho dos lotes para processamento
BATCH_SIZE=1000

# Comprimento mínimo de palavras para processar
MIN_WORD_LENGTH=2

# Comprimento máximo de palavras
MAX_WORD_LENGTH=50

# -------------------- PATHS --------------------
# Diretórios de dados (relativo à raiz do projeto)
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
EMBEDDINGS_DIR=data/embeddings
LOGS_DIR=data/logs

# -------------------- MASAKHANE FILES --------------------
MASAKHANE_POS_FILE=data/raw/masakhane-pos/pos_swa_test.txt
MASAKHANE_NER_FILE=data/raw/masakhane-ner/ner_swa_test.txt
MASAKHANE_NEWS_FILE=data/raw/masakhane-news/news_swa_test.tsv

# -------------------- KAMUSI FILES --------------------
KAMUSI_CSV_FILE=data/raw/kamusi/words.csv
KAMUSI_JSON_FILE=data/raw/kamusi/words.json

# -------------------- DATABASE VERSION --------------------
# Versão do schema do banco de dados
SCHEMA_VERSION=0.2.0

# -------------------- APPLICATION --------------------
# Nome da aplicação
APP_NAME=Swahili NLP RAG

# Ambiente: development, staging, production
ENVIRONMENT=development

# Debug mode (não use em produção!)
DEBUG=True

# -------------------- API CONFIGURATION (futuro) --------------------
# API host e porta
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -------------------- EXTERNAL SERVICES (opcional) --------------------
# OpenAI API Key (para embeddings/RAG)
# OPENAI_API_KEY=sk-...

# Anthropic API Key (para Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# -------------------- CACHING --------------------
# Cache de embeddings
CACHE_EMBEDDINGS=True

# Tempo de cache (em segundos)
CACHE_TTL=3600

# -------------------- PERFORMANCE --------------------
# Número de workers para processamento paralelo
NUM_WORKERS=4

# Timeout para queries longas (em segundos)
QUERY_TIMEOUT=30

# -------------------- SECURITY --------------------
# Secret key para sessions (gere um valor aleatório em produção)
SECRET_KEY=your-secret-key-here-change-in-production

# JWT expiration (em horas)
JWT_EXPIRATION=24

# -------------------- MONITORING (opcional) --------------------
# Sentry DSN para error tracking
# SENTRY_DSN=https://...

# Analytics
# ANALYTICS_ENABLED=False
